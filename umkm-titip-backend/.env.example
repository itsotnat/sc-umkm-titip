# Salin file ini menjadi .env lalu isi nilai yang sesuai. Jangan pernah commit file .env ke git.

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=umkm_titip
DB_USER=umkm_titip_user
DB_PASSWORD=ganti_dengan_password_kuat

# Auth
JWT_SECRET=ganti_dengan_string_acak_panjang_dan_unik
JWT_EXPIRES_IN=7d

# CORS (domain frontend/mobile yang diizinkan, pisahkan dengan koma; * untuk semua saat development)
CORS_ORIGIN=*

# Email (SMTP) untuk kirim kode reset password.
# Gmail: aktifkan verifikasi 2 langkah, lalu buat "App Password" di akun Google
# dan isi di SMTP_PASS (16 karakter, tanpa spasi). Kosongkan SMTP_USER/SMTP_PASS
# saat development: kode reset akan dicetak di log server, bukan dikirim.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=UMKM Titip <emailkamu@gmail.com>

# Folder penyimpanan foto profil (di Docker dipetakan ke volume uploads_data)
UPLOAD_DIR=/usr/src/app/uploads
