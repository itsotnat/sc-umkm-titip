# Salin file ini menjadi .env lalu isi nilai yang sesuai. Jangan pernah commit file .env ke git.

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=umkm_titip
DB_USER=umkm_titip_user
DB_PASSWORD=ganti_dengan_password_kuat

# Auth
JWT_SECRET=ganti_dengan_string_acak_panjang_dan_unik
JWT_EXPIRES_IN=7d

# CORS (domain frontend/mobile yang diizinkan, pisahkan dengan koma; * untuk semua saat development)
CORS_ORIGIN=*
